{
  "name": "@domternal/core",
  "version": "1.2.0",
  "description": "MIT-licensed, framework-agnostic headless rich text editor engine built on ProseMirror",
  "author": "https://github.com/ThomasNowHere",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@domternal/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./locales/de": {
      "@domternal/source": "./src/locales/de.ts",
      "import": {
        "types": "./dist/locales/de.d.ts",
        "default": "./dist/locales/de.js"
      },
      "require": {
        "types": "./dist/locales/de.d.cts",
        "default": "./dist/locales/de.cjs"
      }
    }
  },
  "files": [
    "dist",
    "THIRD-PARTY-LICENSES.md"
  ],
  "scripts": {
    "build": "node ../../scripts/locale-build.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && node ../../scripts/prepare-publish-manifest.mjs",
    "postpublish": "git checkout package.json",
    "prepack": "node ../../scripts/locale-build.mjs --check"
  },
  "dependencies": {
    "@domternal/pm": "workspace:*",
    "@floating-ui/dom": "^1.7.5",
    "linkifyjs": "^4.3.2"
  },
  "peerDependencies": {
    "linkedom": "^0.18.0"
  },
  "peerDependenciesMeta": {
    "linkedom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "jsdom": "^28.1.0",
    "linkedom": "^0.18.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  },
  "keywords": [
    "prosemirror",
    "editor",
    "rich-text",
    "rich-text-editor",
    "wysiwyg",
    "headless",
    "typescript",
    "open-source",
    "self-hosted",
    "domternal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domternal/domternal.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/domternal/domternal/issues"
  },
  "homepage": "https://domternal.dev",
  "typesVersions": {
    "*": {
      "locales/*": [
        "dist/locales/*"
      ]
    }
  }
}
