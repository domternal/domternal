{
  "name": "@domternal/vanilla",
  "version": "1.2.0",
  "description": "MIT-licensed framework-free DOM components for the Domternal rich text editor",
  "author": "https://github.com/ThomasNowHere",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "@domternal/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@domternal/core": ">=1.1.0 <2.0.0"
  },
  "devDependencies": {
    "@domternal/core": "workspace:*",
    "jsdom": "^28.1.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && node ../../scripts/prepare-publish-manifest.mjs",
    "postpublish": "git checkout package.json"
  },
  "keywords": [
    "vanilla",
    "dom",
    "astro",
    "svelte",
    "prosemirror",
    "editor",
    "rich-text",
    "rich-text-editor",
    "wysiwyg",
    "typescript",
    "web-components",
    "domternal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domternal/domternal.git",
    "directory": "packages/vanilla"
  },
  "bugs": {
    "url": "https://github.com/domternal/domternal/issues"
  },
  "homepage": "https://domternal.dev"
}
