{
  "name": "@domternal/extension-markdown",
  "version": "0.15.0",
  "description": "Bidirectional Markdown for Domternal: parse Markdown into the editor (paste, insert, setContent) and serialize documents back to GitHub-flavored Markdown, covering the full Notion-style schema",
  "author": "https://github.com/ThomasNowHere",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --clean",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && node ../../scripts/prepare-publish-manifest.mjs",
    "postpublish": "git checkout package.json"
  },
  "dependencies": {
    "markdown-it": "^15.0.0"
  },
  "peerDependencies": {
    "@domternal/core": ">=0.15.0",
    "@domternal/pm": ">=0.15.0"
  },
  "devDependencies": {
    "@domternal/core": "workspace:*",
    "@domternal/extension-details": "workspace:*",
    "@domternal/extension-emoji": "workspace:*",
    "@domternal/extension-image": "workspace:*",
    "@domternal/extension-math": "workspace:*",
    "@domternal/extension-mention": "workspace:*",
    "@domternal/extension-table": "workspace:*",
    "@domternal/pm": "workspace:*",
    "@types/markdown-it": "^14.1.2",
    "jsdom": "^28.1.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  },
  "keywords": [
    "prosemirror",
    "editor",
    "markdown",
    "gfm",
    "import",
    "export",
    "paste",
    "notion",
    "domternal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domternal/domternal.git",
    "directory": "packages/extension-markdown"
  },
  "bugs": {
    "url": "https://github.com/domternal/domternal/issues"
  },
  "homepage": "https://domternal.dev"
}
