{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // NOT ./dist, which is ng-packagr's `dest` in ng-package.json. nx infers a
    // typecheck target from this file and runs tsc in build mode over it, so a
    // shared directory means `pnpm typecheck` writes fourteen declaration files
    // and a tsbuildinfo into the directory `files: ["dist"]` publishes. A real
    // release is unaffected, because ng-packagr empties dest first, but with a
    // warm nx cache `pnpm build` replays and never re-runs it, so the packed
    // tarball grows by everything tsc left behind.
    "outDir": "./.tsbuild",
    "module": "es2022",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "lib": ["es2022", "dom"],
    "verbatimModuleSyntax": false,
    "customConditions": []
  },
  "angularCompilerOptions": {
    "compilationMode": "partial"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", ".tsbuild"],
  "references": [
    {
      "path": "../core"
    }
  ]
}
