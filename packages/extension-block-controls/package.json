{
  "name": "@domternal/extension-block-controls",
  "version": "1.0.1",
  "description": "Notion-style block controls for the Domternal editor: BlockHandle (hover gutter + drag), SlashCommand, FloatingMenu, ContextMenu, keyboard reorder, and SmartPaste",
  "author": "https://github.com/ThomasNowHere",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --clean",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && node ../../scripts/prepare-publish-manifest.mjs",
    "postpublish": "git checkout package.json"
  },
  "peerDependencies": {
    "@domternal/core": ">=1.0.0",
    "@domternal/pm": ">=1.0.0"
  },
  "devDependencies": {
    "@domternal/core": "workspace:*",
    "@domternal/pm": "workspace:*",
    "jsdom": "^28.1.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  },
  "keywords": [
    "prosemirror",
    "editor",
    "block-controls",
    "block-menu",
    "floating-menu",
    "slash-command",
    "block-handle",
    "drag-handle",
    "notion",
    "domternal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domternal/domternal.git",
    "directory": "packages/extension-block-controls"
  },
  "bugs": {
    "url": "https://github.com/domternal/domternal/issues"
  },
  "homepage": "https://domternal.dev"
}
