{
  "name": "@domternal/extension-math",
  "version": "0.15.0",
  "description": "LaTeX math (inline + block) for Domternal editor with a pluggable renderer (KaTeX by default)",
  "author": "https://github.com/ThomasNowHere",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --clean",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && node ../../scripts/prepare-publish-manifest.mjs",
    "postpublish": "git checkout package.json"
  },
  "peerDependencies": {
    "@domternal/core": ">=0.15.0",
    "@domternal/pm": ">=0.15.0",
    "katex": "^0.16.0 || ^0.17.0"
  },
  "devDependencies": {
    "@domternal/core": "workspace:*",
    "@domternal/pm": "workspace:*",
    "jsdom": "^28.1.0",
    "katex": "^0.17.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  },
  "keywords": [
    "prosemirror",
    "editor",
    "math",
    "latex",
    "katex",
    "domternal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domternal/domternal.git",
    "directory": "packages/extension-math"
  },
  "bugs": {
    "url": "https://github.com/domternal/domternal/issues"
  },
  "homepage": "https://domternal.dev"
}
