{
  "name": "@domternal/extension-paste-cleanup",
  "version": "1.2.0",
  "description": "Opt-in Office paste cleanup and bounded, network-free HTML normalization for Domternal",
  "author": "https://github.com/ThomasNowHere",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./html": {
      "import": {
        "types": "./dist/html/index.d.ts",
        "default": "./dist/html/index.js"
      },
      "require": {
        "types": "./dist/html/index.d.cts",
        "default": "./dist/html/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "THIRD-PARTY-LICENSES.md"
  ],
  "scripts": {
    "build": "tsup --clean",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && node ../../scripts/prepare-publish-manifest.mjs",
    "postpublish": "git checkout package.json"
  },
  "dependencies": {
    "hast-util-from-parse5": "^8.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "parse5": "^7.3.0"
  },
  "peerDependencies": {
    "@domternal/core": ">=1.2.0 <2.0.0",
    "@domternal/pm": ">=1.2.0 <2.0.0"
  },
  "devDependencies": {
    "@domternal/core": "workspace:*",
    "@domternal/pm": "workspace:*",
    "@types/hast": "^3.0.4",
    "jsdom": "^28.1.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  },
  "keywords": [
    "prosemirror",
    "editor",
    "paste",
    "word",
    "office",
    "sanitize",
    "domternal",
    "rich-text-editor",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domternal/domternal.git",
    "directory": "packages/extension-paste-cleanup"
  },
  "bugs": {
    "url": "https://github.com/domternal/domternal/issues"
  },
  "homepage": "https://domternal.dev",
  "typesVersions": {
    "*": {
      "html": [
        "dist/html/index.d.ts"
      ]
    }
  }
}
