# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo

# dependencies
node_modules

# IDEs and editors
/.idea
.history

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
coverage
coverage-index.html
npm-debug.log
yarn-error.log

# Playwright artifacts (root matrix e2e + per-app suites)
test-results/
playwright-report/

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data

# Angular CLI build cache (library and demo app builds)
.angular/
