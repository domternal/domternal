{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "customConditions": ["@domternal/source"]
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../packages/vanilla"
    },
    {
      "path": "../../packages/extension-toc"
    },
    {
      "path": "../../packages/extension-table"
    },
    {
      "path": "../../packages/extension-mention"
    },
    {
      "path": "../../packages/extension-math"
    },
    {
      "path": "../../packages/extension-markdown"
    },
    {
      "path": "../../packages/extension-image"
    },
    {
      "path": "../../packages/extension-emoji"
    },
    {
      "path": "../../packages/extension-details"
    },
    {
      "path": "../../packages/extension-code-block-lowlight"
    },
    {
      "path": "../../packages/extension-block-controls"
    },
    {
      "path": "../../packages/core"
    }
  ]
}
