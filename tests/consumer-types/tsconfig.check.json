{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "strict": true,
    "noUnusedLocals": false,
    "noEmit": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["consumer.ts"]
}
