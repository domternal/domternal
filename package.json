{
  "name": "@domternal/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.34.4 <11"
  },
  "scripts": {
    "build": "nx run-many --target=build --all",
    "dev": "nx run-many --target=dev --all",
    "test": "nx run-many --target=test --all",
    "test:coverage": "nx run-many --target=test --all -- --coverage",
    "coverage:index": "pnpm test:coverage && node scripts/generate-coverage-index.mjs",
    "test:e2e": "nx run-many --target=test:e2e --all",
    "test:e2e:matrix": "playwright test --config e2e/playwright.config.ts",
    "lint": "nx run-many --target=lint --all && eslint tests scripts e2e eslint.config.mjs",
    "typecheck": "nx run-many --target=typecheck --all",
    "typecheck:e2e": "tsc --noEmit --project e2e/tsconfig.json",
    "test:types-consumer": "pnpm --filter @domternal/tests-consumer-types test:types",
    "test:api-surface": "node --test tests/api-surface/dump.test.mjs && node tests/api-surface/dump.mjs --check",
    "test:third-party-notices": "node --test tests/third-party-notices/check.test.mjs && node tests/third-party-notices/check.mjs",
    "test:api-surface:update": "node tests/api-surface/dump.mjs",
    "test:hidden-attribute": "node --test tests/hidden-attribute/check.test.mjs && node tests/hidden-attribute/check.mjs",
    "test:css-vars": "node --test tests/css-vars/check.test.mjs && node tests/css-vars/check.mjs",
    "test:theme-tokens": "node --test tests/theme-tokens/check.test.mjs && node tests/theme-tokens/check.mjs",
    "test:bundle-size": "node --test tests/bundle-size/check.test.mjs && node tests/bundle-size/check.mjs",
    "test:package-policy": "node --test tests/package-policy/check.test.mjs && node tests/package-policy/check.mjs",
    "test:package-artifacts": "node --test tests/package-artifacts/check.test.mjs && node tests/package-artifacts/check.mjs",
    "test:ssr-import": "node --test tests/ssr-import/check.test.mjs && node tests/ssr-import/check.mjs",
    "test:ci-wiring": "node --test tests/ci-wiring/*.test.mjs && node tests/ci-wiring/check.mjs",
    "test:single-prosemirror": "node --test tests/single-prosemirror/check.test.mjs && node tests/single-prosemirror/check.mjs",
    "test:dedupe-reachable": "node --test tests/dedupe-reachable/check.test.mjs && node tests/dedupe-reachable/check.mjs",
    "test:pm-ranges": "node --test tests/pm-ranges/check.test.mjs && node tests/pm-ranges/check.mjs",
    "test:frozen-contract": "node --test tests/frozen-contract/check.test.mjs && node tests/frozen-contract/check.mjs",
    "test:externals": "node --test tests/externals/check.test.mjs && node tests/externals/check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/domternal/domternal"
  },
  "author": "https://github.com/ThomasNowHere",
  "private": true,
  "pnpm": {
    "overrides": {
      "@angular/core": "^21.2.20",
      "@angular/common": "^21.2.20",
      "@angular/compiler": "^21.2.20",
      "@angular/compiler-cli": "^21.2.20",
      "@angular/forms": "^21.2.20",
      "@angular/platform-browser": "^21.2.20",
      "@angular/router": "^21.2.20",
      "@angular/build": "^21.2.21",
      "@angular/cli": "^21.2.21",
      "prosemirror-commands": "^1.7.2",
      "prosemirror-dropcursor": "^1.8.3",
      "prosemirror-gapcursor": "^1.4.1",
      "prosemirror-history": "^1.5.0",
      "prosemirror-inputrules": "^1.5.1",
      "prosemirror-keymap": "^1.2.3",
      "prosemirror-model": "^1.25.11",
      "prosemirror-schema-list": "^1.5.1",
      "prosemirror-state": "^1.4.4",
      "prosemirror-tables": "^1.8.5",
      "prosemirror-transform": "^1.12.0",
      "prosemirror-view": "^1.42.2",
      "@arethetypeswrong/core>fflate": "0.7.4",
      "minimatch@3": "^3.1.5",
      "minimatch@9": "^9.0.9",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "js-yaml@4": "^4.3.1",
      "ajv@6": "^6.15.0",
      "yaml@1": "^1.10.3",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.5",
      "flatted": "^3.4.4",
      "fast-uri": "^3.1.5",
      "ws": "^8.21.3",
      "@babel/core": "^7.29.7",
      "@babel/plugin-transform-modules-systemjs": "^7.29.8",
      "less": "^4.9.0",
      "svgo@>=4.0.0 <4.0.2": "^4.0.2",
      "tsup>esbuild": "^0.28.1"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^9.39.2",
    "@nx/js": "22.7.8",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "nx": "22.7.8",
    "prettier": "~3.8.0",
    "publint": "^0.3.21",
    "semver": "^7.8.1",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.1.10"
  }
}
