{
  "name": "@domternal/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "nx run-many --target=build --all",
    "dev": "nx run-many --target=dev --all",
    "test": "nx run-many --target=test --all",
    "test:coverage": "nx run-many --target=test --all -- --coverage",
    "coverage:index": "pnpm test:coverage && node scripts/generate-coverage-index.mjs",
    "test:e2e": "nx run-many --target=test:e2e --all",
    "lint": "nx run-many --target=lint --all",
    "typecheck": "nx run-many --target=typecheck --all",
    "test:types-consumer": "pnpm --filter @domternal/tests-consumer-types test:types",
    "test:api-surface": "node tests/api-surface/dump.mjs --check",
    "test:api-surface:update": "node tests/api-surface/dump.mjs",
    "test:css-vars": "node tests/css-vars/check.mjs",
    "test:bundle-size": "node tests/bundle-size/check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/domternal/domternal"
  },
  "author": "https://github.com/ThomasNowHere",
  "private": true,
  "pnpm": {
    "overrides": {
      "@angular/core": "^21.2.5",
      "@angular/common": "^21.2.5",
      "@angular/compiler": "^21.2.5",
      "@angular/compiler-cli": "^21.2.5",
      "@angular/forms": "^21.2.5",
      "@angular/platform-browser": "^21.2.5",
      "@angular/router": "^21.2.5",
      "@angular/build": "^21.2.3",
      "@angular/cli": "^21.2.3",
      "@arethetypeswrong/core>fflate": "0.7.4"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^9.39.2",
    "@nx/js": "22.3.3",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.8",
    "@swc/helpers": "~0.5.18",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "nx": "22.3.3",
    "prettier": "~3.8.0",
    "publint": "^0.3.21",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.0.17"
  }
}
